{
  "manifest_version": 1,
  "id": "com.rohanpieterse.gsheets_oauth",
  "name": "Google Sheets (OAuth)",
  "version": "0.1.0",
  "description": "Create, read, and modify Google Sheets as YOUR Google account via OAuth. Files are owned by you (not a service account), so they appear in your personal Drive and sharing works the normal way. Companion to com.rohanpieterse.gsheets which uses a service account.",
  "homepage": "https://developers.google.com/sheets/api",
  "mcp": {
    "transport": "stdio",
    "command": "node",
    "args": ["./dist/index.js"],
    "env": {
      "GOOGLE_OAUTH_CLIENT_ID": "${secrets.gsheets_oauth_tokens.client_id}",
      "GOOGLE_OAUTH_ACCESS_TOKEN": "${secrets.gsheets_oauth_tokens.access_token}",
      "GOOGLE_OAUTH_REFRESH_TOKEN": "${secrets.gsheets_oauth_tokens.refresh_token}"
    }
  },
  "install": [
    { "shell": "npm install" },
    { "shell": "npm run build" }
  ],
  "auth": {
    "type": "oauth2_pkce",
    "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_url": "https://oauth2.googleapis.com/token",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ],
    "client_id": "PASTE_YOUR_OAUTH_CLIENT_ID_HERE",
    "redirect": "loopback",
    "store_as": "gsheets_oauth_tokens"
  },
  "permissions": {
    "network": [
      "sheets.googleapis.com",
      "www.googleapis.com",
      "oauth2.googleapis.com",
      "accounts.google.com"
    ],
    "secrets": ["gsheets_oauth_tokens"]
  },
  "storage": [
    {
      "key": "last_sheet_id",
      "type": "text",
      "label": "Last sheet id",
      "description": "Spreadsheet id of the most recently created sheet. Other quick commands can target it via ${storage.last_sheet_id}.",
      "default": ""
    }
  ],
  "quick_commands": [
    {
      "trigger": "osheet_create",
      "description": "Create a new Google Sheet (OAuth) with the given title",
      "tool": "create_sheet",
      "arg_key": "title"
    },
    {
      "trigger": "osheet_read",
      "description": "Read a range from the last-created sheet (OAuth, default A1:Z100)",
      "tool": "read_range",
      "args": {
        "spreadsheet_id": "${storage.last_sheet_id}",
        "range": "A1:Z100"
      }
    }
  ]
}
